{
    "compilerOptions": {
        "module": "CommonJS",
        "target": "ES6",
        "outDir": "compiled",
        "rootDir": "src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*"]
}
